# Public HTTPS entrypoint for a hostname you own (PUBLIC_HOST).
# Caddy obtains and renews a Let's Encrypt certificate over HTTP-01,
# which requires TCP port 80 to reach this container from the internet.
#
# basic_auth is imported with no path matcher, so it covers the whole HTTPS
# site: the UI, static assets, /api/events, and every other API route.
# Caddy serves the ACME HTTP-01 challenge on port 80 itself and redirects
# every other plain-HTTP request to HTTPS before this site's routes run,
# so the challenge is not a way around the password and the password is
# not sent on port 80.
{
	email {$ACME_EMAIL}
}

{$PUBLIC_HOST} {
	import auth.caddy

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		-Server
	}

	request_body {
		max_size 1MB
	}

	# Scan and inventory pages keep a Server-Sent Events stream open on
	# /api/events. Buffering or compressing that response holds events
	# until the stream ends, so the UI never updates live. basic_auth
	# above still applies to this handle.
	@events path /api/events
	handle @events {
		reverse_proxy pantry:8080 {
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy pantry:8080
	}
}
